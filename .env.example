EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Required by Expo API routes that verify Clerk sessions.
# Prefer CLERK_JWT_KEY for networkless verification. Use \n for PEM newlines.
CLERK_JWT_KEY=
# Alternatively, use the Clerk secret key instead of CLERK_JWT_KEY.
# CLERK_SECRET_KEY=

STREAM_API_KEY=
STREAM_API_SECRET=
GEMINI_API_KEY=
# Server-side URL for the Vision Agent HTTP server.
VISION_AGENT_URL=http://127.0.0.1:8000

EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
